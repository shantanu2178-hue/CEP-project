{
  "name": "adultera-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\" --kill-others-on-fail",
    "server": "node server/server.js",
