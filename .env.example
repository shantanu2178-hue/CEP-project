# PostgreSQL Database Connection
DATABASE_URL="postgresql://username:password@host:5432/dbname?schema=public"

# Vercel Blob Storage Token (for file uploads)
# Create a Vercel Blob store and get the read/write token from Vercel dashboard
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxx"

# MapTiler API Key (public browser key)
# Get your key from https://www.maptiler.com/
VITE_MAPTILER_KEY="your_maptiler_public_key"

# Comma-separated list of allowed CORS origins (for production)
# Example: ALLOWED_ORIGINS="https://your-app.vercel.app"
ALLOWED_ORIGINS="http://localhost:5173"
